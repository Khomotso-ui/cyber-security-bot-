<Window x:Class="chat_part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:chat_part2"
        mc:Ignorable="d"
        Title="Chant-Bot"
        Height="620"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="Red">

    <Grid>

        
        <Border Width="820"
                Height="540"
                Background="White"
                CornerRadius="20"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

              
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

               
                    
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">

                        <TextBlock Text="Chant-Bot"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="Red"/>

                        <TextBlock Text="Cybersecurity Awareness Chat-Bot"
                                   FontSize="14"
                                   Foreground="Red"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                </Grid>

               
                <Border Grid.Row="1"
                        Background="Red"
                        CornerRadius="15"
                        Padding="10"
                        Margin="0,10,0,10">

                    <RichTextBox x:Name="txtChat"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="14"
                                 Padding="10"/>
                </Border>

                
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>


                    <Border Background="Red"
                            CornerRadius="12"
                            Margin="0,0,10,0">

                        <TextBox x:Name="txtMessage"
                                 Height="45"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="14"
                                 Padding="15,10"
                                 VerticalContentAlignment="Center"/>
                    </Border>

                 
                    <Button Grid.Column="1"
                            Content="Send"
                            Height="45"
                            Width="110"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="Red"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Button_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>

                    </Button>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>